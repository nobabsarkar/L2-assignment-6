model Assign{

    id String @id @default(uuid())
    status AssignStatus @default(PENDING)

    complainId String
    complain Complain @relation(fields: [complainId], references: [id], onDelete: Cascade)

    serviceWorkerId String 
    serviceWorker User @relation("ServiceWorkerAssign",fields: [serviceWorkerId], references: [id], onDelete: Cascade)

    adminId String 
    admin User @relation("AdminAssign",fields: [adminId], references: [id], onDelete: Cascade)


    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("assigns")
}